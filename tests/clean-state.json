{
  "force_clean_state": [
    {
      "name": "check_current_state",
      "tool": "local-eval",
      "args": {"code": "@nrepl-mcp-server.state.connection/connection-state"},
      "description": "See current connection state"
    },
    {
      "name": "force_reset_state",
      "tool": "local-eval", 
      "args": {"code": "(reset! nrepl-mcp-server.state.connection/connection-state {:status :disconnected :socket nil :port nil :connection-id nil :last-activity nil})"},
      "description": "Force reset connection state to clean disconnected"
    },
    {
      "name": "verify_clean_state",
      "tool": "local-eval",
      "args": {"code": "@nrepl-mcp-server.state.connection/connection-state"},
      "description": "Verify state is now clean"
    },
    {
      "name": "now_try_connect",
      "tool": "nrepl-connection",
      "args": {"op": "connect", "connection": "56626"},
      "description": "Now try connecting with clean state"
    }
  ]
}